{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=app;Username=postgres",
    "Redis": "localhost:6379"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "net10:",
    "ConnectTimeoutMs": 5000,
    "OperationTimeoutMs": 3000,
    "AbortOnConnectFail": true
  },
  "Client": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Jwt": {
    "Issuer": "net10-angular19",
    "Audience": "net10-angular19-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Identity": {
    "AllowRegistration": false,
    "RunSeeders": false,
    "ConfirmEmailOnProvision": true,
    "RefreshTokenRetentionDays": 30,
    "RefreshTokenCleanupBatchSize": 500,
    "RequireMfaForPrivileged": true,
    "MfaChallengeMinutes": 5,
    "AuthenticatorIssuer": "Net10Angular19",
    "SeedAdmin": {
      "Email": "",
      "Password": ""
    }
  },
  "Authorization": {
    "Cache": {
      "AbsoluteExpirationSeconds": 30
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
